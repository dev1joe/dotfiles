(defcfg
    process-unmapped-keys yes
    concurrent-tap-hold yes
)

(defvar
    tap-time 200
    hold-time 200
)

(defsrc ;; the keys you wish to remap
  esc
  grv     1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab     q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps    a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft    z    x    c    v    b    n    m    ,    .    /    rsft
  lctl    lmet lalt           spc            ralt rmet rctl
)

(deflayer base
    caps
    _     _    _    _    _    _    _    _    _    _    _    _    _    XX
    _     _    _    _    _    _    _    _    _    _    _    _    _    _
    @cpsm @am  @sm  @dm  @fm  _    _    @jm  @km  @lm  @;m  _    XX
    _     _    _    _    _    _    _    _    _    _    _    _
    _     _    @nml           @spcmd         _    _    _
)

(deflayer utils
    esc
    _     _    _    _    _    _    _    _    _    _    _    _    _    XX
    _     _    _    _    _    _    _    home pgdn pgup end  _    _    _
    XX    _    _    _    _    _    _    @al  @ad  @au  @ar  _    XX
    _     C-t  C-,  C-v  C-c  _    _    _    _    _    _    _
    _     _    _                _            _    _    _
)

(deflayer numbers
    esc
    _     _    _    _    _    _    _    kp7  kp8  kp9  _    _    _    XX
    _     _    _    _    _    _    _    kp4  kp5  kp6  -    _    _    _
    XX    _    _    _    _    _    _    kp1  kp2  kp3  +    _    XX
    _     _    _    _    _    _    _    kp0  kp0  .    /    _
    _     _    _                _            _    _    _
)

(defalias
    ;; caps mod
    cpsm (tap-hold $tap-time $hold-time bspc lmet) ;; lmet == left meta (super) key

    ;; home row mode
    am (tap-hold $tap-time $hold-time a lmet)
    sm (tap-hold $tap-time $hold-time s lalt)
    dm (tap-hold $tap-time $hold-time d lsft)
    fm (tap-hold $tap-time $hold-time f lctl)
    jm (tap-hold $tap-time $hold-time j rctl)
    km (tap-hold $tap-time $hold-time k rsft)
    lm (tap-hold $tap-time $hold-time l lalt)
    ;m (tap-hold $tap-time $hold-time ; rmet)

    ;; space bar mod
    spcmd (tap-hold $tap-time $hold-time spc (layer-toggle utils))

    ;; arrows
    al left
    ad down
    au up
    ar right

    ;; numbers layer
    nml (tap-hold $tap-time $hold-time lalt (layer-toggle numbers))
)

;; TODO: create numbers layer and toggle to it using lalt key (the key position) 

(defchordsv2
    ;; (participating-keys) action1 timeout1 release-behaviour1 (disabled-layers1)
    (j k l)                 ret     200      all-released       (utils)
    (s d f)                 esc     200      all-released       (utils)
)
